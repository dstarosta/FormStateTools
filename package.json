    },
    "./package.json": "./package.json"
  },
  "types": "dist/form-state-tools.d.ts",
  "version": "1.0.0",
  "scripts": {
    "check-ts": "node -e \"const v=require('typescript').version; if(v<'5.9.0'){console.error('❌ TS version '+v+' is too low. Need >= 5.9.0');process.exit(1)}\"",
    "build": "npm i && npm run prettier && npm run check-ts && npm run typecheck && npm run lint && npm run test && tsdown --config tsdown.types.config.ts && tsdown && tsdown --config tsdown.vite.config.ts",
    "lint": "eslint .",
    "prettier": "prettier -c src/** tests/**",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "engines": {
    "tsc": ">= 5.9.0"
  },
  "peerDependencies": {
    "lodash-es": ">= 4.17.21",
    "react": ">= 19.2.0",
    "react-dom": ">= 19.2.0",
    "vite": ">= 5.0.0",
    "zod": ">= 4.3.0 < 5.0.0"
  },
  "peerDependenciesMeta": {
